{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 GDB Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stutil",
            "cwd": "${workspaceFolder}",
            "executable": "./build/blink.elf",
            "gdbPath": "gdb-multiarch",
            "device": "STM32F429ZI",
            "svdFile": "./STM32F429.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build"
        }
    ]
}
