mach create
machine LoadPlatformDescription @platforms/cpus/nrf52840.repl
machine LoadPlatformDescriptionFromString "dummy: Mocks.DummyI2CSlave @ twi0 0x68"

# include @renode.py

sysbus LoadELF @../firmwares/nrf52840/build/protocols/TWI/master/Blocking_Mode/Hardware/nrfx/firmware.elf

# 啟動 GDB Server
machine StartGdbServer 3333 true

# 設定 NVIC 的 log 等級為 Error
# logLevel Error sysbus.nvic

# 開啟 I2C1 的詳細 log
# sysbus LogPeripheralAccess i2c1
# sysbus.cpu LogFunctionNames true

# 設定全域 log 等級為 Info 或 Debug (0 = Debug, 1 = Info)
# logLevel 0

# cpu AddHook `sysbus GetSymbolAddress "END_SYMBOLIC_EXECUTION"` "print 'END_SYMBOLIC_EXECUTION has executed'; machine.Pause()"

# start