# Renode 的 STM32F429 GPIO 沒有實作 OTYPER register，故沒有 open-drain 設定

mach create
machine LoadPlatformDescription @platforms/cpus/stm32f429.repl
# Renode 的 STM32F429 沒有放入 DWT，需要自己放
machine LoadPlatformDescriptionFromString "dwt: Miscellaneous.DWT @ sysbus 0xE0001000 { frequency: 72000000 }"
# machine LoadPlatformDescriptionFromString "dummy: Mocks.DummyI2CSlave @ i2c1 0x68"

sysbus LoadELF @../firmwares/stm32f429/build/protocols/I2C/master/Blocking_Mode/Hardware/stm32f4xx-hal-driver/firmware.elf

# 啟動 GDB Server
machine StartGdbServer 3333 true

# 設定 NVIC 的 log 等級為 Error
# logLevel Error sysbus.nvic

# 開啟 I2C1 的詳細 log
# sysbus LogPeripheralAccess i2c1
# sysbus.cpu LogFunctionNames true

# 設定全域 log 等級為 Info 或 Debug (0 = Debug, 1 = Info)
# logLevel 0

# start